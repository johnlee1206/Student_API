# Copy this file to .env for local development.
# On Render, add DATABASE_URL and DATABASE_SSL_ROOT_CERT in the Environment dashboard.
# NEVER put real database passwords or private hostnames in this file!
DATABASE_URL="postgresql://USER:YOUR_PASSWORD_HERE@HOST:5432/postgres?sslmode=require"
PORT=4000
# Locally, set this to the path of your downloaded Supabase root certificate.
# On Render, set it to the full PEM certificate contents, not a local file path.
DATABASE_SSL_ROOT_CERT="C:\path\to\prod-ca-2021.crt"